# Settings of Discover's container image: make image, image-check, scan and push read them.
# A variable already set in the environment wins over the value here.
#
# Every base image is pinned by its version AND by the digest of its multi-platform index, read from Docker Hub
# on 2026-11-02. scripts/image-pins.sh refuses a base that carries only one of the two, here, in the environment
# or as a default in the Dockerfile. To move a base: read the new digest with
#   docker buildx imagetools inspect <name>:<version> --format '{{json .Manifest.Digest}}'
# and change the line here and the matching default in the Dockerfile together.

GOLANG_IMAGE=golang:1.26.10@sha256:670bb5aa5349ae03b8516764718486f4f16399134bdc9acd0c46a23f043ab05c
RUNTIME_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

DISCOVER_REGISTRY=docker.io
DISCOVER_IMAGE=saphan/discover
PUSH_PLATFORMS=linux/amd64,linux/arm64

# A published image carries no finding of these severities, with a fix or without one.
SCOUT_REFUSE_SEVERITIES=critical,high
